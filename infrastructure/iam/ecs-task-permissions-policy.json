{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApplicationTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/football_pickem_*",
        "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/football_pickem_*/index/*"
      ]
    },
    {
      "Sid": "SettingsEncryptionAndSmtpReads",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:football-pickem/*"
    }
  ]
}
