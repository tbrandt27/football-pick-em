{
  "name": "football-pickem",
  "type": "module",
  "version": "1.2.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "astro dev",
    "dev:backend": "nodemon server/index.js",
    "dev:local": "concurrently \"npm run dev:frontend\" \"npm run dev:backend:local\"",
    "dev:backend:local": "npx dotenv-cli -e .env.local -- npm run dev:backend",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run check && npm run test",
    "setup": "node setup.js",
    "start": "./scripts/start.sh",
    "start:production": "NODE_ENV=production ./scripts/start.sh",
    "init-db": "node scripts/init-db.js",
    "check-backend": "node scripts/dev/check-backend.js",
    "docker:build": "docker build -t football-pickem .",
    "docker:run": "docker run -p 8080:8080 football-pickem",
    "localstack:start": "docker-compose -f docker-compose.localstack.yml up -d && sleep 15 && node scripts/dev/update-localstack-secrets.js",
    "localstack:stop": "docker-compose -f docker-compose.localstack.yml down",
    "localstack:status": "docker-compose -f docker-compose.localstack.yml ps",
    "localstack:setup": "node scripts/dev/setup-localstack.js",
    "localstack:test": "node scripts/dev/test-localstack.js",
    "localstack:reset": "docker-compose -f docker-compose.localstack.yml down && docker-compose -f docker-compose.localstack.yml up -d && sleep 15 && npm run localstack:setup && node scripts/dev/update-localstack-secrets.js",
    "localstack:logs": "docker-compose -f docker-compose.localstack.yml logs -f",
    "localstack:clean": "docker-compose -f docker-compose.localstack.yml down -v && rm -rf ./localstack-data"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "@aws-sdk/client-dynamodb": "^3.873.0",
    "@aws-sdk/client-secrets-manager": "^3.873.0",
    "@aws-sdk/lib-dynamodb": "^3.873.0",
    "@heroicons/react": "^2.2.0",
    "@nanostores/react": "^1.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nanostores": "^1.0.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^4.3.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^9.2.4",
    "csv-parser": "^3.0.0",
    "dotenv-cli": "^7.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
